      "Class weights -> benign: 0.690  malignant: 1.819\n"
     ]
    }
   ],
   "source": [
    "# Count samples in each class\n",
    "all_labels  = [s[1] for s in full_dataset.samples]\n",
    "n_benign    = all_labels.count(0)\n",
    "n_malignant = all_labels.count(1)\n",
    "n_total     = len(all_labels)\n",
    "\n",
    "print(f'Benign   : {n_benign}  nodules ({100*n_benign/n_total:.1f}%)')\n",
    "print(f'Malignant: {n_malignant} nodules ({100*n_malignant/n_total:.1f}%)')\n",
    "\n",
    "# Formula: total / (num_classes * count_per_class)\n",
    "# The class with fewer samples gets a higher weight\n",
