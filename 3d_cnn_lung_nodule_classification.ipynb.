    "for nid in unique_nodules:\n",
    "    patient_to_nodules[get_patient_id(nid)].append(nid)\n",
    "unique_patients = list(patient_to_nodules.keys())\n",
    "patient_labels = [1 if any(nodule_to_label[n] == 1 for n in patient_to_nodules[p]) else 0 for p in unique_patients]\n",
    "\n",
    "train_patients, test_patients = train_test_split(\n",
    "    unique_patients, test_size=TEST_SIZE, random_state=RANDOM_SEED, stratify=patient_labels\n",
    ")\n",
    "train_patient_set = set(train_patients)\n",
