    "## Section 3 — Custom 3D Dataset\n",
    "PyTorch requires data to be organized in a special class called a Dataset.\n",
    "This class tells PyTorch how to find, load, and preprocess each CT volume.\n",
    "\n",
    "### What is Data Augmentation?\n",
    "Augmentation creates slightly modified versions of training images (flipped, rotated,\n",
    "brightness-shifted) so the model sees more variety. This helps prevent **overfitting**\n",
    "— where the model memorizes training data instead of learning generalizable features.\n",
    "Augmentation is applied ONLY to training data, never to test data.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset ready: 1075 nodules  (malignant=296, benign=779)  augment=False\n"
     ]
    }
   ],
   "source": [
    "class NoduleDataset3D(Dataset):\n",
    "    \"\"\"\n",
    "    Custom PyTorch Dataset for 3D lung nodule CT volumes.\n",
    "    Each sample is a full 3D volume resized to (VOL_SIZE x VOL_SIZE x VOL_SIZE)\n",
    "    returned as a tensor of shape (1, VOL_SIZE, VOL_SIZE, VOL_SIZE).\n",
    "    The '1' is the channel dimension — CT scans are grayscale (1 channel).\n",
    "    Label: 1 = malignant, 0 = benign\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, malignant_dir, benign_dir, vol_size=48, augment=False):\n",
    "        # Runs once when the dataset is created\n",
    "        # Scans both folders and builds a list of all available nodule files\n",
    "        self.vol_size = vol_size\n",
    "        self.augment  = augment\n",
    "        self.samples  = []  # holds tuples of (file_path, label, nodule_id)\n",
    "\n",
    "        # Loop through both folders, assigning label 1=malignant, 0=benign\n",
    "        for label, folder in [(1, malignant_dir), (0, benign_dir)]:\n",
    "            for nii_path in sorted(Path(folder).glob('*.nii.gz')):\n",
    "                nodule_id = nii_path.stem.replace('.nii', '')\n",
    "                self.samples.append((str(nii_path), label, nodule_id))\n",
    "\n",
    "        n_mal = sum(1 for _, l, _ in self.samples if l == 1)\n",
    "        n_ben = sum(1 for _, l, _ in self.samples if l == 0)\n",
    "        print(f'Dataset ready: {len(self.samples)} nodules  '\n",
    "              f'(malignant={n_mal}, benign={n_ben})  augment={augment}')\n",
    "\n",
    "    def __len__(self):\n",
    "        # PyTorch calls this to find out how many samples are in the dataset\n",
    "        return len(self.samples)\n",
    "\n",
    "    def _preprocess(self, vol):\n",
    "        \"\"\"\n",
    "        Prepares a raw CT volume for the model:\n",
    "        1. Converts to 32-bit float (required by PyTorch)\n",
    "        2. Normalizes voxel values to [0, 1] — neural networks train better\n",
    "           with small input values rather than raw Hounsfield Units\n",
    "        3. Resizes to VOL_SIZE x VOL_SIZE x VOL_SIZE so all inputs are the same size\n",
    "        \"\"\"\n",
    "        vol = vol.astype(np.float32)\n",
    "        vmin, vmax = vol.min(), vol.max()\n",
    "        if vmax > vmin:  # avoid division by zero\n",
    "            vol = (vol - vmin) / (vmax - vmin)\n",
    "        else:\n",
    "            vol = np.zeros_like(vol)\n",
    "        factors = [self.vol_size / s for s in vol.shape]  # zoom factors per axis\n",
    "        vol = scipy.ndimage.zoom(vol, factors, order=1)    # trilinear interpolation\n",
    "        return vol\n",
    "\n",
    "    def _elastic_deform(self, vol):\n",
    "        \"\"\"\n",
    "        Elastic deformation warps the volume with smooth random displacements.\n",
    "        This mimics natural anatomical variation between patients and helps\n",
    "        the model generalize to nodules it has never seen before.\n",
    "        \"\"\"\n",
    "        shape    = vol.shape\n",
    "        strength = 2.0  # how far voxels can be displaced\n",
    "        smooth   = 4.0  # smoothness of the deformation\n",
    "        dx = scipy.ndimage.gaussian_filter(np.random.randn(*shape) * strength, smooth)\n",
    "        dy = scipy.ndimage.gaussian_filter(np.random.randn(*shape) * strength, smooth)\n",
    "        dz = scipy.ndimage.gaussian_filter(np.random.randn(*shape) * strength, smooth)\n",
    "        x, y, z = np.meshgrid(\n",
    "            np.arange(shape[0]), np.arange(shape[1]), np.arange(shape[2]), indexing='ij'\n",
    "        )\n",
    "        coords = [np.clip(x+dx, 0, shape[0]-1),\n",
    "                  np.clip(y+dy, 0, shape[1]-1),\n",
    "                  np.clip(z+dz, 0, shape[2]-1)]\n",
    "        return scipy.ndimage.map_coordinates(vol, coords, order=1, mode='reflect')\n",
    "\n",
    "    def _augment(self, vol):\n",
    "        \"\"\"\n",
    "        Applies random transformations so the model sees different versions\n",
    "        of each nodule on each epoch, forcing it to learn robust features\n",
    "        rather than memorizing specific pixel patterns.\n",
    "        \"\"\"\n",
    "        # Random flips along each axis (50% chance each)\n",
    "        # Nodule malignancy does not depend on orientation\n",
    "        if random.random() > 0.5:\n",
    "            vol = np.flip(vol, axis=0).copy()  # flip top-to-bottom\n",
    "        if random.random() > 0.5:\n",
    "            vol = np.flip(vol, axis=1).copy()  # flip left-to-right\n",
    "        if random.random() > 0.5:\n",
    "            vol = np.flip(vol, axis=2).copy()  # flip front-to-back\n",
    "        # Random rotation up to 20 degrees in the axial plane\n",
    "        angle = random.uniform(-20, 20)\n",
    "        vol = scipy.ndimage.rotate(vol, angle, axes=(0, 1), reshape=False)\n",
    "        # Random brightness shift (simulates CT scanner variation between hospitals)\n",
    "        if random.random() > 0.5:\n",
    "            vol = np.clip(vol * random.uniform(0.8, 1.2), 0, 1)\n",
    "        # Elastic deformation (50% chance)\n",
    "        if random.random() > 0.5:\n",
    "            vol = self._elastic_deform(vol)\n",
    "        return vol.astype(np.float32)\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        \"\"\"\n",
    "        PyTorch calls this every time it needs one sample.\n",
    "        Loads the CT volume, preprocesses it, optionally augments it,\n",
    "        and returns it as a PyTorch tensor with its label.\n",
    "        \"\"\"\n",
    "        nii_path, label, _ = self.samples[idx]\n",
    "        vol = nib.load(nii_path).get_fdata()  # load .nii.gz file\n",
    "        vol = self._preprocess(vol)            # normalize and resize\n",
    "        if self.augment:\n",
    "            vol = self._augment(vol)           # random transforms\n",
    "        # np.newaxis turns shape (48,48,48) into (1,48,48,48) by adding a channel dim\n",
    "        tensor = torch.tensor(vol[np.newaxis, ...], dtype=torch.float32)\n",
    "        return tensor, label\n",
    "\n",
    "\n",
    "# Create the full dataset without augmentation\n",
    "# Augmentation is added only to the training subset later\n",
    "full_dataset = NoduleDataset3D(\n",
    "    MALIGNANT_DIR, BENIGN_DIR, vol_size=VOL_SIZE, augment=False\n",
    ")\n"
   ]
  },
