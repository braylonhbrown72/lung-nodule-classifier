    "class ResBlock3D(nn.Module):\n",
    "    \"\"\"\n",
    "    3D Residual Block with skip connection.\n",
    "    Structure:\n",
    "      input\n",
    "        |-> Conv3d -> BatchNorm -> ReLU -> Conv3d -> BatchNorm |\n",
    "        |---------------------------------------------> Add -> ReLU -> output\n",
    "    The skip connection lets the block learn only what needs to change.\n",
    "    \"\"\"\n",
    "    def __init__(self, channels):\n",
    "        super().__init__()\n",
    "        self.conv1 = nn.Conv3d(channels, channels, kernel_size=3, padding=1)\n",
    "        self.bn1   = nn.BatchNorm3d(channels)\n",
    "        self.conv2 = nn.Conv3d(channels, channels, kernel_size=3, padding=1)\n",
    "        self.bn2   = nn.BatchNorm3d(channels)\n",
    "\n",
    "    def forward(self, x):\n",
    "        residual = x                            # save original input for skip connection\n",
    "        x = F.relu(self.bn1(self.conv1(x)))    # first conv + normalize + activate\n",
    "        x = self.bn2(self.conv2(x))             # second conv + normalize\n",
    "        return F.relu(x + residual)             # add skip connection then activate\n",
    "\n",
    "\n",
    "class CNN3D(nn.Module):\n",
    "    \"\"\"\n",
    "    Full 3D ResNet CNN for lung nodule classification.\n",
    "    Input:  (batch_size, 1, 48, 48, 48) — one grayscale 3D volume per sample\n",
    "    Output: (batch_size, 2) — scores for [benign, malignant]\n",
    "    Filter progression:  1 -> 32 -> 64 -> 128 -> 256\n",
    "    Spatial progression: 48 -> 24 -> 12 -> 6 -> 3\n",
    "    \"\"\"\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "        # Conv Block 1: detects low-level features (edges, gradients)\n",
    "        self.conv1 = nn.Conv3d(1,   32, kernel_size=3, padding=1)\n",
    "        self.bn1   = nn.BatchNorm3d(32)\n",
    "        self.res1  = ResBlock3D(32)\n",
    "\n",
    "        # Conv Block 2: detects mid-level features (textures, small shapes)\n",
    "        self.conv2 = nn.Conv3d(32,  64, kernel_size=3, padding=1)\n",
    "        self.bn2   = nn.BatchNorm3d(64)\n",
    "        self.res2  = ResBlock3D(64)\n",
    "\n",
    "        # Conv Block 3: detects higher-level features (nodule margins, lobulation)\n",
    "        self.conv3 = nn.Conv3d(64,  128, kernel_size=3, padding=1)\n",
    "        self.bn3   = nn.BatchNorm3d(128)\n",
    "        self.res3  = ResBlock3D(128)\n",
    "\n",
    "        # Conv Block 4: detects most abstract features (malignancy patterns)\n",
    "        self.conv4 = nn.Conv3d(128, 256, kernel_size=3, padding=1)\n",
    "        self.bn4   = nn.BatchNorm3d(256)\n",
    "        self.res4  = ResBlock3D(256)\n",
    "\n",
    "        # MaxPool3d halves spatial dimensions after each conv block\n",
    "        self.pool  = nn.MaxPool3d(2, 2)\n",
    "\n",
    "        # Global Average Pooling averages each of 256 feature maps into one number\n",
    "        # This gives 256 values total — much more compact than flattening all voxels\n",
    "        # and dramatically reduces overfitting\n",
    "        self.gap   = nn.AdaptiveAvgPool3d(1)\n",
    "\n",
    "        # Dropout zeros 60% of neurons during training\n",
    "        # Forces the network to learn redundant representations\n",
    "        self.drop  = nn.Dropout(0.6)\n",
    "\n",
    "        # Fully connected layers combine all features into a final prediction\n",
    "        self.fc1 = nn.Linear(256, 128)  # compress 256 features to 128\n",
    "        self.fc2 = nn.Linear(128, 2)    # output 2 scores: [benign, malignant]\n",
    "\n",
    "    def forward(self, x):\n",
    "        # Data flows through each block: conv -> normalize -> activate -> pool -> residual\n",
    "        x = self.pool(F.relu(self.bn1(self.conv1(x))))  # -> (batch, 32, 24, 24, 24)\n",
    "        x = self.res1(x)\n",
    "        x = self.pool(F.relu(self.bn2(self.conv2(x))))  # -> (batch, 64, 12, 12, 12)\n",
    "        x = self.res2(x)\n",
    "        x = self.pool(F.relu(self.bn3(self.conv3(x))))  # -> (batch, 128, 6, 6, 6)\n",
    "        x = self.res3(x)\n",
    "        x = self.pool(F.relu(self.bn4(self.conv4(x))))  # -> (batch, 256, 3, 3, 3)\n",
    "        x = self.res4(x)\n",
    "        x = self.gap(x).view(x.size(0), -1)             # -> (batch, 256)\n",
    "        x = F.relu(self.fc1(x))                          # -> (batch, 128)\n",
    "        x = self.drop(x)                                 # randomly zero 60%\n",
    "        return self.fc2(x)                               # -> (batch, 2)\n",
