    "# ===== SECTION 1: IMPORTS =====\n",
    "import time, random\n",
    "import numpy as np\n",
    "import nibabel as nib\n",
    "import matplotlib.pyplot as plt\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import Dataset, DataLoader, Subset\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import confusion_matrix, classification_report, f1_score\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "import scipy.ndimage\n",
    "\n",
    "# ===== SECTION 2: CONFIG =====\n",
    "MALIGNANT_DIR = \"/Users/braylon/Downloads/Nodule_Patches_Full3D/malignant\"\n",
    "BENIGN_DIR    = \"/Users/braylon/Downloads/Nodule_Patches_Full3D/benign\"\n",
    "VOL_SIZE = 48\n",
    "TEST_SIZE = 0.2\n",
    "RANDOM_SEED = 42\n",
    "BATCH_SIZE = 8\n",
    "NUM_WORKERS = 0\n",
    "LR = 1e-4\n",
    "EPOCHS = 50\n",
    "EARLY_STOP_PAT = 7\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "\n",
    "# ===== SECTION 3: DATASET CLASS =====\n",
    "class NoduleDataset3D(Dataset):\n",
    "    def __init__(self, malignant_dir, benign_dir, vol_size=48, augment=False):\n",
    "        self.vol_size = vol_size\n",
    "        self.augment  = augment\n",
    "        self.samples  = []\n",
    "        for label, folder in [(1, malignant_dir), (0, benign_dir)]:\n",
    "            for nii_path in sorted(Path(folder).glob('*.nii.gz')):\n",
    "                nodule_id = nii_path.stem.replace('.nii', '')\n",
    "                self.samples.append((str(nii_path), label, nodule_id))\n",
    "        n_mal = sum(1 for _, l, _ in self.samples if l == 1)\n",
    "        n_ben = sum(1 for _, l, _ in self.samples if l == 0)\n",
    "        print(f'Dataset ready: {len(self.samples)} nodules (malignant={n_mal}, benign={n_ben}) augment={augment}')\n",
    "\n",
    "    def __len__(self):\n",
    "        return len(self.samples)\n",
    "\n",
    "    def _preprocess(self, vol):\n",
    "        vol = vol.astype(np.float32)\n",
    "        vmin, vmax = vol.min(), vol.max()\n",
    "        if vmax > vmin:\n",
    "            vol = (vol - vmin) / (vmax - vmin)\n",
    "        else:\n",
    "            vol = np.zeros_like(vol)\n",
    "        factors = [self.vol_size / s for s in vol.shape]\n",
    "        vol = scipy.ndimage.zoom(vol, factors, order=1)\n",
    "        return vol\n",
    "\n",
    "    def __getitem__(self, idx):\n",
    "        nii_path, label, _ = self.samples[idx]\n",
    "        vol = nib.load(nii_path).get_fdata()\n",
    "        vol = self._preprocess(vol)\n",
    "        tensor = torch.tensor(vol[np.newaxis, ...], dtype=torch.float32)\n",
    "        return tensor, label\n",
    "\n",
    "full_dataset = NoduleDataset3D(MALIGNANT_DIR, BENIGN_DIR, vol_size=VOL_SIZE, augment=False)\n",
    "\n",
    "# ===== SECTION 4: CLASS WEIGHTS =====\n",
    "all_labels  = [s[1] for s in full_dataset.samples]\n",
    "n_benign    = all_labels.count(0)\n",
    "n_malignant = all_labels.count(1)\n",
    "n_total     = len(all_labels)\n",
    "weight_benign    = n_total / (2 * n_benign)\n",
    "weight_malignant = n_total / (2 * n_malignant)\n",
    "class_weights    = torch.tensor([weight_benign, weight_malignant], dtype=torch.float32).to(device)\n",
    "\n",
    "# ===== SECTION 5: PATIENT-LEVEL TRAIN/TEST SPLIT (leakage-safe) =====\n",
    "nodule_to_label = {nid: lbl for _, lbl, nid in full_dataset.samples}\n",
    "unique_nodules  = list(nodule_to_label.keys())\n",
    "\n",
    "def get_patient_id(nodule_id):\n",
    "    return nodule_id.rsplit('_', 1)[0]\n",
    "\n",
    "from collections import defaultdict\n",
